# Copy to backend/.env for local development. Never commit real values.

APP_ENV=development              # production enables strict checks and JSON logs
SECRET_KEY=change-me-to-64-random-characters   # python -c "import secrets; print(secrets.token_urlsafe(48))"
LOG_LEVEL=INFO

# PostgreSQL (Neon/Railway URLs like postgres://...?sslmode=require are accepted as-is)
DATABASE_URL=postgresql+asyncpg://purplesol:purplesol@localhost:5432/purplesol

# Comma-separated browser origins allowed to call the API directly
API_CORS_ORIGINS=http://localhost:3000

# First admin, created only when the users table is empty
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional key for machine-to-machine event ingestion (X-API-Key header)
INGEST_API_KEY=

# Object storage: "local" for development, "s3" for S3 / Cloudflare R2 / MinIO
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_ENDPOINT_URL=                 # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_UPLOAD_BYTES=2147483648
VIDEO_RETENTION_DAYS=30

# Computer vision (worker)
YOLO_MODEL=yolo11n.pt
CV_DEVICE=auto                   # auto | cpu | cuda:0
ANALYSIS_FPS=5
